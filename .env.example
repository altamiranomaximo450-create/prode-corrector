# ---------------------------------------------------------------------------
# PRODE CORRECTOR - Variables de entorno
# Copiar este archivo a .env.local (desarrollo) o cargarlo en Vercel (produccion).
# NINGUNA de estas variables empieza con NEXT_PUBLIC_: no llegan nunca al navegador.
# ---------------------------------------------------------------------------

# Contrasena del panel de administracion. OBLIGATORIA.
# En desarrollo, si no se define, se usa "prode-demo" y la app muestra un aviso.
ADMIN_PASSWORD=cambia-esta-clave

# Secreto para firmar la cookie de sesion (HMAC). OBLIGATORIO en produccion.
# Generar con:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Duracion de la sesion en horas (por defecto 12)
SESSION_HOURS=12

# ---------------------------------------------------------------------------
# Almacenamiento
#   file     -> archivos JSON en ./.data  (por defecto en desarrollo local)
#   memory   -> memoria del proceso, se pierde al reiniciar (fallback en Vercel)
#   supabase -> Postgres de Supabase via API REST (recomendado en produccion)
# ---------------------------------------------------------------------------
STORAGE_DRIVER=file

# Solo si STORAGE_DRIVER=supabase
SUPABASE_URL=
# Clave *service_role* (secreta, solo servidor, NUNCA con prefijo NEXT_PUBLIC_). Ver supabase/schema.sql
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# PDFs grandes (subida directa a Supabase Storage + worker aparte)
#
# Requiere STORAGE_DRIVER=supabase configurado arriba. Sin esto, el panel
# sigue funcionando pero sólo admite el PDF sincronico hasta MAX_PDF_MB.
# ---------------------------------------------------------------------------

# Iguales a SUPABASE_URL, pero con el prefijo NEXT_PUBLIC_: el navegador los
# necesita para subir los chunks directo a Storage. NO son secretos: la clave
# anon/publishable esta disenada para exponerse (Storage la acepta solo junto
# con el token firmado que el servidor emite para cada chunk puntual).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Nombre del bucket de Storage para los chunks de PDF (se crea con supabase/schema.sql)
PRODE_PDF_BUCKET=prode-pdfs

# Tamano maximo por chunk en MB. El plan gratuito de Supabase Storage rechaza
# CUALQUIER archivo de mas de 50 MB (limite duro de la plataforma, no
# configurable en el free tier): no subir esto por encima de 49.
MAX_CHUNK_MB=45

# ---------------------------------------------------------------------------
# Demo
# DEMO_MODE=off  desactiva la carga de datos de demostracion.
# ---------------------------------------------------------------------------
DEMO_MODE=on

# Desactiva por completo el procesamiento de PDF (util para retirar la demo
# sin borrar el despliegue). Valores: on | off
PROCESAMIENTO_HABILITADO=on
