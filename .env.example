# ---------------------------------------------------------------------------
# CORRECTOR DE PRODE - Variables de entorno
#
# Copiar a .env.local (desarrollo) y cargar las mismas en Vercel (produccion).
# NO poner valores reales en este archivo: no lleva secretos.
#
# Supabase es el unico almacen: sin estas variables la aplicacion no arranca.
# ---------------------------------------------------------------------------

# --- Servidor y worker (SECRETO: nunca con prefijo NEXT_PUBLIC_) -----------
# Project Settings -> API -> Project URL
SUPABASE_URL=
# Project Settings -> API -> service_role secret
SUPABASE_SERVICE_ROLE_KEY=

# --- Navegador (publicas) --------------------------------------------------
# El navegador las necesita para subir las partes del PDF directo a Storage.
# No son secretas: la clave anon esta disenada para exponerse, y Storage solo la
# acepta junto con el token firmado que el servidor emite para cada parte.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Arranque automatico del worker (SOLO en Vercel) -----------------------
# Sin estas dos, en produccion nadie levanta el worker y el PDF queda encolado.
# En desarrollo NO hacen falta: `npm run dev` arranca el worker como proceso
# hijo automaticamente.
#
# Repositorio donde vive .github/workflows/worker.yml, en formato usuario/repo.
GITHUB_WORKER_REPO=
# Token de GitHub con permiso para disparar el workflow (repository_dispatch).
#   Fine-grained token: Repository access = solo este repo,
#                       Permissions -> Repository permissions -> Contents: Read and write
#   Token clasico: alcanza el scope `repo`.
# Es un SECRETO: va solo en Vercel (Settings -> Environment Variables), nunca en git.
GITHUB_WORKER_TOKEN=

# --- Opcionales ------------------------------------------------------------
# Bucket de Storage donde van las partes del PDF (lo crea supabase/schema.sql).
PRODE_PDF_BUCKET=prode-pdfs

# Tamano maximo por parte, en MB. El plan gratuito de Supabase Storage rechaza
# cualquier objeto de mas de 50 MB (tope duro de la plataforma): no subir de 47.
MAX_CHUNK_MB=45

# Ejecutable de Python para el rescate con PyMuPDF/OCR. Vacio = se busca solo
# (python3, python, py -3). Si no hay Python, las paginas escaneadas quedan
# vacias y el resto del PDF se procesa igual.
PYTHON_BIN=

# Cuanto puede estar un trabajo sin latido antes de considerarlo abandonado, en
# milisegundos. Solo se toca para probar la reanudacion por checkpoint.
PRODE_LATIDO_FRIO_MS=
