{
  "name": "prode-corrector",
  "version": "1.0.0",
  "private": true,
  "description": "Corrector de boletas de Prode: nueva fecha, PDF de boletas, procesamiento y ranking.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "pdf:prueba": "node scripts/generar-pdf-prueba.mjs",
    "typecheck": "tsc --noEmit",
    "worker": "tsx worker/index.ts",
    "worker:once": "tsx worker/index.ts --once",
    "pdf:verificar": "tsx scripts/verificar-prueba.mts",
    "pdf:probar": "tsx scripts/probar-pdf.mts",
    "worker:bucle": "tsx worker/index.ts",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.48.1",
    "next": "^15.5.24",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "4.8.69",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
